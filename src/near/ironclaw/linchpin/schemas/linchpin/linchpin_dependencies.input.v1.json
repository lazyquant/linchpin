{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(near:mainnet:)?[a-z0-9][a-z0-9._~-]*(#[a-z-]+:[A-Za-z0-9._~-]+)?$"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "deployed-by",
          "holds-role",
          "legacy-oracle",
          "owned-by",
          "priced-by",
          "routes-through",
          "super-admin-of",
          "upgraded-by"
        ]
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "maxHops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": [
    "subject"
  ]
}
